# Postgres. Local: `npm run db` sobe um PGlite em 127.0.0.1:54329.
# Produção: string de conexão do Neon (use a URL "pooled").
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Protege /api/revalidate e /api/cron/* (a Vercel envia "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=troque-isto

# Para onde a ingestão manda o aviso de "dados novos" (revalida o cache do site).
# Local: http://localhost:3000 · Produção: https://seu-projeto.vercel.app
REVALIDATE_URL=http://localhost:3000

# Contato no User-Agent das requisições ao Wikidata/Wikipédia (política da Wikimedia).
ATLAS_CONTACT=

# Só a partir da Fase 4.
# ANTHROPIC_API_KEY=
